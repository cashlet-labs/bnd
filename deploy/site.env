# Settings of the hosted demo. The deploy scripts pass this file to docker
# compose. Changing the host name: see docs/deploy.md.

# Host name the page and verifier are served on.
SITE_HOST=bnd.septemlabs.com
# The site's own relays: the page uses them by default and offers them first
# to NIP-46 signers.
SITE_RELAYS=wss://relay.septemlabs.com,wss://relay.bongacash.co.ke
SITE_RELAYS_LABEL=Cashlet relays
# Relays the verifier asks whether a login uses the current binding: the
# site's own first, then the public relays bnd-nostr defaults to.
VERIFIER_RELAYS=wss://relay.septemlabs.com,wss://relay.bongacash.co.ke,wss://nos.lol,wss://relay.primal.net,wss://offchain.pub,wss://relay.damus.io,wss://nostr.mom
# Complete relay answers needed before a login is decided.
VERIFIER_MIN_RELAYS=2
