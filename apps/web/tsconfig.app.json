{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@cashlet-labs/bnd-core": ["../../packages/core/src/index.ts"],
      "@cashlet-labs/bnd-nostr": ["../../packages/nostr/src/index.ts"],
      "@cashlet-labs/bnd-nostr/testing": ["../../packages/nostr/src/testing.ts"],
      "@cashlet-labs/bnd-did": ["../../packages/did/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
