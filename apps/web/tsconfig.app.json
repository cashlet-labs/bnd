{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@cashlet-labs/bnd": ["../../packages/bnd/src/core/index.ts"],
      "@cashlet-labs/bnd/nostr": ["../../packages/bnd/src/nostr/index.ts"],
      "@cashlet-labs/bnd/did": ["../../packages/bnd/src/did/index.ts"],
      "@cashlet-labs/bnd/testing": ["../../packages/bnd/src/nostr/testing.ts"]
    }
  },
  "include": ["src", "test"]
}
