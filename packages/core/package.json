{
  "name": "@cashlet-labs/bnd-core",
  "version": "0.4.0",
  "description": "BND-1 protocol core: binding records, proofs and verification",
  "keywords": [
    "bitcoin-cash",
    "bch",
    "nostr",
    "identity",
    "binding",
    "bip340",
    "cashaddr"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Septem Labs <hello@septemlabs.com>",
  "homepage": "https://github.com/cashlet-labs/bnd/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/cashlet-labs/bnd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cashlet-labs/bnd.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "nostr-tools": "2.26.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
