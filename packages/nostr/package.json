{
  "name": "@cashlet-labs/bnd-nostr",
  "version": "0.4.0",
  "description": "BND relay client and discovery: publish, find and verify bindings on Nostr relays",
  "keywords": [
    "nostr",
    "relay",
    "bitcoin-cash",
    "bch",
    "identity",
    "discovery"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Septem Labs <hello@septemlabs.com>",
  "homepage": "https://github.com/cashlet-labs/bnd/tree/main/packages/nostr#readme",
  "bugs": {
    "url": "https://github.com/cashlet-labs/bnd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cashlet-labs/bnd.git",
    "directory": "packages/nostr"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cashlet-labs/bnd-core": "^0.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
