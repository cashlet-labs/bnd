# Copy this file to `.env` and fill in your own values. `.env` is ignored by git.
# Nothing in this file is a secret: every value here is public or local.

# --- Browser demo (apps/web) -------------------------------------------------
# Address of the verifier the demo's dev and preview servers forward requests to.
# Leave unset to use http://127.0.0.1:<PORT>.
# VERIFIER_URL=http://127.0.0.1:8787
# The demo's own relay, shown as "Local demo relay" in the page.
# VITE_LOCAL_RELAY=ws://127.0.0.1:7777

# --- Verifier (apps/verifier) ------------------------------------------------
# Port the verifier listens on.
PORT=8787
# Public base URL the verifier is reached at. Challenges name <PUBLIC_URL>/login.
# Leave unset locally to use http://127.0.0.1:<PORT>.
# PUBLIC_URL=https://app.example
# Relays used to check that a login uses the current binding, comma-separated.
# Leave unset to use the library's default public relays.
# BND_RELAYS=wss://nos.lol,wss://relay.primal.net,wss://offchain.pub
# Complete relay answers needed before a login is decided. Use 1 with one local relay.
BND_MIN_RELAYS=2
# Set to "off" to stop the one-line-per-login log on stdout.
# BND_LOG=off
# Interface to listen on. Leave unset for loopback only; containers use 0.0.0.0.
# HOST=127.0.0.1
# Header holding the client's address, set by a reverse proxy in front of the
# verifier, for per-client rate limits. Only set it when every request comes
# through a proxy that replaces the header (Traefik does for X-Real-Ip);
# otherwise clients choose their own address. Addresses are hashed in memory.
# BND_CLIENT_IP_HEADER=x-real-ip
